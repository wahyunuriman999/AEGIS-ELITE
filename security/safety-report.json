    "vulnerabilities": [
        {
            "vulnerability_id": "99546",
            "package_name": "starlette",
            "ignored": {},
            "ignored_reason": null,
            "ignored_expires": null,
            "vulnerable_spec": [
                "<1.0.1"
            ],
            "all_vulnerable_specs": [
                "<1.0.1"
            ],
            "analyzed_version": "1.0.0",
            "analyzed_requirement": {
                "raw": "starlette==1.0.0",
                "extras": [],
                "marker": null,
                "name": "starlette",
                "specifier": "==1.0.0",
                "url": null,
                "found": "C:\\Users\\ROG G532 LV\\AppData\\Local\\Programs\\Python\\Python312\\Lib\\site-packages\\starlette-1.0.0.dist-info"
            },
            "advisory": "Affected versions of the starlette package are vulnerable to HTTP Request Smuggling (Inconsistent Interpretation of HTTP Requests) due to improper validation of the Host header when reconstructing the request URL. The Request.url property concatenates the attacker-controllable Host header with the request path and re-parses the resulting string without validating the header against the RFC 9112 and RFC 3986 grammars, so embedding /, ?, or # characters in the Host value shifts the path, query, and fragment boundaries and causes request.url.path to diverge from the wire path that the ASGI server uses for routing. An unauthenticated remote attacker can send a crafted Host header to applications that rely on request.url.path inside middleware for path-based authorization, causing the middleware to evaluate a forged path while the underlying route still executes, which results in authentication bypass on otherwise protected endpoints.",
            "is_transitive": false,
            "published_date": null,
            "fixed_versions": [],
            "closest_versions_without_known_vulnerabilities": [],
            "resources": [],
            "CVE": "CVE-2026-48710",
            "severity": null,
