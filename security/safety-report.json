        },
        {
            "vulnerability_id": "98489",
            "package_name": "praisonaiagents",
            "ignored": {},
            "ignored_reason": null,
            "ignored_expires": null,
            "vulnerable_spec": [
                "<=4.6.36"
            ],
            "all_vulnerable_specs": [
                "<=4.6.36"
            ],
            "analyzed_version": "1.6.147",
            "analyzed_requirement": {
                "raw": "praisonaiagents==1.6.147",
                "extras": [],
                "marker": null,
                "name": "praisonaiagents",
                "specifier": "==1.6.147",
                "url": null,
                "found": "C:\\Users\\ROG G532 LV\\AppData\\Local\\Programs\\Python\\Python312\\Lib\\site-packages\\praisonaiagents-1.6.147.dist-info"
            },
            "advisory": "Affected versions of the praisonaiagents package are vulnerable to Improper Access Control due to the bundled praisonaiagents ToolExecutionMixin.execute_tool resolving unknown tool names against module globals and __main__ rather than rejecting them. The resolution path in praisonaiagents/agent/tool_execution.py falls back to globals().get(function_name) and then to getattr(__main__, function_name, None) after the declared tool list and registry both miss, and because the default Agent initialisation sets _perm_allow to None the permission gate treats undeclared callables as allowed and invokes any matching function with caster-supplied arguments. An attacker able to influence tool-call names emitted to an agent can invoke arbitrary application callables that were never registered as tools, executing privileged helper functions in process scope with the application's own privileges and producing unauthorised state changes, data exposure, or command execution depending on what is loaded.",
            "is_transitive": false,
            "published_date": null,
            "fixed_versions": [],
            "closest_versions_without_known_vulnerabilities": [],
            "resources": [],
            "CVE": "CVE-2026-44339",
            "severity": null,
